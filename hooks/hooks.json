{
  "description": "Run dev-knowledge-recap right after Claude opens a pull request",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/on-pr.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/on-pr.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
